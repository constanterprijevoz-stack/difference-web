---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
const {
  title = 'BrandistiQ — Digitalna rješenja',
  description = 'SEO, web, AI i web aplikacije za poduzetnike i tvrtke u Hrvatskoj.',
  image = '/og-default.svg',
  type = 'website',
  breadcrumbs = [],
  structuredData = [],
} = Astro.props;
const siteUrl = 'https://difference-usluge.com.hr';
const canonical = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const organization = { '@context':'https://schema.org', '@type':'Organization', name:'BrandistiQ', url:`${siteUrl}/`, description, brand:{ '@type':'Brand', name:'BrandistiQ' } };
const breadcrumbSchema = breadcrumbs.length > 0 ? { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:breadcrumbs.map((item, index) => ({ '@type':'ListItem', position:index+1, name:item.name, item:new URL(item.url, siteUrl).toString() })) } : null;
const schemas = [organization, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...structuredData];
---
<!doctype html>
<html lang="hr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#07090d" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="hr_HR" />
  <meta property="og:site_name" content="BrandistiQ" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <Analytics />
  {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>)}
</head>
<body>
  <a class="skip-link" href="#main-content">Preskoči na sadržaj</a>
  <Header />
  <main id="main-content">
    {breadcrumbs.length > 0 && <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href="/">Početna</a>{breadcrumbs.slice(1).map((item, index) => <><span aria-hidden="true">/</span>{index === breadcrumbs.length - 2 ? <span aria-current="page">{item.name}</span> : <a href={item.url}>{item.name}</a>}</>)}</nav>}
    <slot />
  </main>
  <Footer />
</body>
</html>
