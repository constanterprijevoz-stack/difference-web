---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('projekti', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const projectSchema = {
  '@context':'https://schema.org',
  '@type':'CreativeWork',
  name:entry.data.title,
  description:entry.data.description,
  url:new URL(Astro.url.pathname, 'https://difference-usluge.com.hr').toString(),
  creator:{ '@type':'Organization', name:'BrandistiQ', url:'https://difference-usluge.com.hr/' }
};
---
<BaseLayout title={`${entry.data.title} | BrandistiQ`} description={entry.data.description} breadcrumbs={[{name:'Početna',url:'/'},{name:'Projekti',url:'/projekti/'},{name:entry.data.title,url:`/projekti/${entry.id}/`}] } structuredData={[projectSchema]}>
  <article class="project-detail">
    <div class="container project-detail-wrap">
      <div class="eyebrow">Projekt{entry.data.type ? ` · ${entry.data.type}` : ''}</div>
      <h1>{entry.data.title}</h1>
      <p class="article-lead">{entry.data.description}</p>

      {entry.data.cover && (
        <figure class="project-cover">
          <img src={entry.data.cover} alt={entry.data.coverAlt || entry.data.title} width="1400" height="788" fetchpriority="high" decoding="async" />
        </figure>
      )}

      <div class="project-intro-grid">
        <div class="article-body"><Content /></div>
        {entry.data.externalUrl && (
          <aside class="project-visit">
            <div class="project-visit-label">Live projekt</div>
            <p>Želite vidjeti stvarni projekt? Otvorite ga u novoj kartici.</p>
            <a class="button" href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">Otvori projekt <span>↗</span></a>
          </aside>
        )}
      </div>

      {entry.data.gallery.length > 0 && (
        <section class="project-gallery" aria-labelledby="project-gallery-title">
          <div class="eyebrow">Galerija</div>
          <h2 id="project-gallery-title">Projekt izbliza.</h2>
          <p class="gallery-lead">Odabrani prikazi projekta optimizirani su za brzo učitavanje i raspoređeni uz tekst tako da svaki ekran ima svoj kontekst.</p>
          <div class="project-gallery-list">
            {entry.data.gallery.map((item, index) => (
              <figure class:list={['gallery-item', { 'gallery-item-reverse': index % 2 === 1 }]}>
                <div class="gallery-media">
                  <img src={item.image} alt={item.alt} width={item.width || 1200} height={item.height || 1200} loading="lazy" decoding="async" />
                </div>
                <figcaption>
                  <span class="gallery-index">{String(index + 1).padStart(2,'0')}</span>
                  <span>{item.caption || item.alt}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <CTA title="Imate sličnu ideju?" text="Razgovarajmo o tome kako je možemo pretvoriti u funkcionalno digitalno rješenje." />
    </div>
  </article>
</BaseLayout>

<style>
.project-detail{padding:90px 0 120px}
.project-detail-wrap{max-width:1120px}
.project-detail h1{max-width:900px;margin:14px 0 18px}
.project-cover{margin:48px 0 58px;border:1px solid rgba(255,255,255,.1);overflow:hidden;background:#0d1219}
.project-cover img{display:block;width:100%;height:auto}
.project-intro-grid{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:56px;align-items:start}
.project-visit{position:sticky;top:32px;padding:24px;border:1px solid rgba(255,255,255,.1);background:#0c1118}
.project-visit-label{font-size:.72rem;text-transform:uppercase;letter-spacing:.14em;color:#8f9aaa;margin-bottom:10px}
.project-visit p{margin:0 0 20px;color:#aeb8c8;line-height:1.55}
.project-gallery{margin:100px 0 90px}
.project-gallery h2{margin:10px 0 12px}
.gallery-lead{max-width:720px;color:#aeb8c8;line-height:1.6;margin:0 0 42px}
.project-gallery-list{display:flex;flex-direction:column;gap:52px}
.gallery-item{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,320px);gap:44px;align-items:center;padding:34px 0;border-top:1px solid rgba(255,255,255,.09)}
.gallery-item-reverse{grid-template-columns:minmax(220px,320px) minmax(0,1fr)}
.gallery-item-reverse .gallery-media{grid-column:2;grid-row:1}
.gallery-item-reverse figcaption{grid-column:1;grid-row:1}
.gallery-media{display:flex;justify-content:center;background:#0b1016;border:1px solid rgba(255,255,255,.08);padding:14px;overflow:hidden}
.gallery-media img{display:block;width:auto;max-width:100%;height:auto;max-height:620px;object-fit:contain}
.gallery-item figcaption{display:flex;gap:18px;align-items:flex-start;color:#aeb8c8;line-height:1.65}
.gallery-index{flex:none;font-family:'Space Grotesk',sans-serif;font-weight:600;color:#19d8b1}
@media(max-width:820px){
  .project-intro-grid{grid-template-columns:1fr;gap:32px}
  .project-visit{position:static}
  .gallery-item,.gallery-item-reverse{grid-template-columns:1fr;gap:22px}
  .gallery-item-reverse .gallery-media,.gallery-item-reverse figcaption{grid-column:auto;grid-row:auto}
  .gallery-media{padding:10px}
  .gallery-media img{max-height:600px}
}
@media(max-width:720px){.project-detail{padding:60px 0 90px}.project-cover{margin:34px 0 42px}.project-gallery{margin:72px 0}}
</style>
