---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout title="BrandistiQ — Digitalna rješenja koja vas čine vidljivijima" description="SEO, web, AI i web aplikacije za poduzetnike i tvrtke u Hrvatskoj. Digitalna rješenja koja povezuju vidljivost, tehnologiju i poslovne ciljeve." structuredData={[{ '@context':'https://schema.org', '@type':'WebSite', name:'BrandistiQ', url:'https://difference-usluge.com.hr/' }]}>
  <section class="hero-home"><div class="hero-glow"></div><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow">BrandistiQ · digitalni brend obrta Difference</div><h1>Digitalna rješenja <em>koja vas čine vidljivijima.</em></h1><p class="hero-lead">SEO, web i AI rješenja za poduzetnike i tvrtke koje žele biti pronađene, razumljive i relevantne u modernom digitalnom svijetu.</p><div class="actions"><a class="button" href="/kontakt/">Razgovarajmo o projektu <span>↗</span></a><a class="text-link" href="/projekti/">Pogledaj projekte <span>→</span></a></div></div><div class="hero-orbit" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit-core"><span>Q</span></div><div class="orbit-node node-one">SEO</div><div class="orbit-node node-two">WEB</div><div class="orbit-node node-three">AI</div></div></div></section>
  <section class="trust-strip"><div class="container trust-inner"><span>SEO</span><i></i><span>WEB</span><i></i><span>AI</span><i></i><span>WEB APLIKACIJE</span><i></i><span>HRVATSKA · REMOTE</span></div></section>
  <section class="section"><div class="container"><SectionHeading eyebrow="Što radimo" title="Digitalna strategija ne mora biti komplicirana." text="Povezujemo ono što ljudi vide, ono što tražilice razumiju i ono što vaše poslovanje stvarno treba."/><div class="services-grid"><ServiceCard number="01" title="SEO & Search" description="Optimizacija web stranica za Google, Bing, lokalno pretraživanje i nove načine pronalaženja informacija." href="/seo/"/><ServiceCard number="02" title="Web" description="Profesionalne web stranice za obrte i tvrtke, od strukture i dizajna do tehničkog SEO temelja." href="/web-stranice/"/><ServiceCard number="03" title="AI" description="Chatbotovi, asistenti i automatizacije koje imaju konkretan poslovni zadatak — bez AI-ja radi AI-ja." href="/ai-rjesenja/"/><ServiceCard number="04" title="Web aplikacije" description="Digitalni alati, kalkulatori, portali i druga rješenja po mjeri za specifične poslovne procese." href="/web-aplikacije/"/></div></div></section>
  <section class="section section-dark"><div class="container split"><div><div class="eyebrow">Naš pristup</div><h2>Ne krećemo od tehnologije. Krećemo od problema.</h2></div><div class="split-copy"><p>Web stranica, SEO, AI ili web aplikacija imaju smisla tek kada rješavaju konkretan poslovni cilj.</p><p>Zato rješenja gradimo modularno: počinjemo od onoga što je potrebno danas, ali ostavljamo prostor za ono što će trebati sutra.</p><a class="text-link" href="/o-nama/">Kako radimo <span>→</span></a></div></div></section>
  <section class="section"><div class="container"><SectionHeading eyebrow="Od ideje do stvarnog proizvoda" title="Projekti koji nisu ostali samo na ideji." text="Vlastiti i razvojni projekti pokazuju kako pristupamo problemu, strukturi, UX-u i tehnologiji."/><div class="projects-grid"><ProjectCard type="Web aplikacija" title="Smart-troškovnik" description="Digitalni alat za izračun troškova i pretvaranje složenog poslovnog procesa u jednostavno korisničko iskustvo." href="/projekti/smart-troskovnik/"/><ProjectCard type="Digitalno rješenje" title="DriveQ" description="Projekt digitalizacije usluge povezane s transportom i mobilnošću." href="/projekti/driveq/"/><ProjectCard type="EPR · web aplikacija" title="EPR Check" description="Digitalni alat koji složen proces provjere pretvara u strukturirano korisničko iskustvo." href="/projekti/epr-check/"/><ProjectCard type="Digitalni proizvod" title="EPR Report" description="Nastavak EPR Checka: strukturirani digitalni izvještaj iz prikupljenih podataka." href="/projekti/epr-report/"/></div><div class="section-link"><a class="text-link" href="/projekti/">Svi projekti <span>→</span></a></div></div></section>
  <section class="section insight-section"><div class="container insight"><div><div class="eyebrow">Digitalni vodič</div><h2>Odgovori na pitanja koja poduzetnici stvarno postavljaju.</h2></div><div><p>Praktični vodiči o SEO-u, web stranicama, AI rješenjima i web aplikacijama — bez nepotrebnog tehničkog žargona.</p><a class="button secondary" href="/vodic/">Otvori vodič <span>↗</span></a></div></div></section>
  <div class="container"><CTA /></div>
</BaseLayout>
