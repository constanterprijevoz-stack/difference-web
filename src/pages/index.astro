---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTA from '../components/CTA.astro';

const projectEntries = await getCollection('projekti', ({ data }) => !data.draft);
const projectById = new Map(projectEntries.map((project) => [project.id, project]));
---
<BaseLayout title="BrandistiQ — Digitalna rješenja koja vas čine vidljivijima" description="SEO, web, AI i web aplikacije za poduzetnike i tvrtke u Hrvatskoj. Digitalna rješenja koja povezuju vidljivost, tehnologiju i poslovne ciljeve." structuredData={[{ '@context':'https://schema.org', '@type':'WebSite', name:'BrandistiQ', url:'https://difference-usluge.com.hr/' }]}>
  <section class="hero-home"><div class="hero-glow"></div><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow">BrandistiQ · digitalni brend obrta Difference</div><h1>Digitalna rješenja <em>koja vas čine vidljivijima.</em></h1><p class="hero-lead">SEO, web i AI rješenja za poduzetnike i tvrtke koje žele biti pronađene, razumljive i relevantne u modernom digitalnom svijetu.</p><div class="actions"><a class="button" href="/kontakt/">Razgovarajmo o projektu <span>↗</span></a><a class="text-link" href="/projekti/">Pogledaj projekte <span>→</span></a></div></div><div class="hero-orbit" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit-core"><span>Q</span></div><div class="orbit-node node-one">SEO</div><div class="orbit-node node-two">WEB</div><div class="orbit-node node-three">AI</div></div></div></section>

  <section class="trust-strip"><div class="container trust-inner"><span>SEO</span><i></i><span>WEB</span><i></i><span>AI</span><i></i><span>WEB APLIKACIJE</span><i></i><span>HRVATSKA · REMOTE</span></div></section>

  <section class="section"><div class="container"><SectionHeading eyebrow="Što radimo" title="Digitalna strategija ne mora biti komplicirana." text="Povezujemo ono što ljudi vide, ono što tražilice razumiju i ono što vaše poslovanje stvarno treba."/><div class="services-grid">
    <ServiceCard number="01" title="SEO & Search" description="Optimizacija web stranica za Google, Bing, lokalno pretraživanje i nove načine pronalaženja informacija." href="/seo/" variant="teal"/>
    <ServiceCard number="02" title="Web" description="Profesionalne web stranice za obrte i tvrtke, od strukture i dizajna do tehničkog SEO temelja." href="/web-stranice/" variant="blue"/>
    <ServiceCard number="03" title="AI" description="Chatbotovi, asistenti i automatizacije koje imaju konkretan poslovni zadatak — bez AI-ja radi AI-ja." href="/ai-rjesenja/" variant="purple"/>
    <ServiceCard number="04" title="Web aplikacije" description="Digitalni alati, kalkulatori, portali i druga rješenja po mjeri za specifične poslovne procese." href="/web-aplikacije/" variant="orange"/>
  </div></div></section>

  <section class="section section-dark"><div class="container split"><div><div class="eyebrow">Naš pristup</div><h2>Ne krećemo od tehnologije. Krećemo od problema.</h2></div><div class="split-copy"><p>Web stranica, SEO, AI ili web aplikacija imaju smisla tek kada rješavaju konkretan poslovni cilj.</p><p>Zato rješenja gradimo modularno: počinjemo od onoga što je potrebno danas, ali ostavljamo prostor za ono što će trebati sutra.</p><a class="text-link" href="/o-nama/">Kako radimo <span>→</span></a></div></div></section>

  <section class="section"><div class="container"><SectionHeading eyebrow="Od ideje do stvarnog proizvoda" title="Projekti koji nisu ostali samo na ideji." text="Vlastiti i razvojni projekti pokazuju kako pristupamo problemu, strukturi, UX-u i tehnologiji."/><div class="projects-grid">
    <ProjectCard type={projectById.get('smart-troskovnik')?.data.type || 'Web aplikacija'} title="Smart-troškovnik" description={projectById.get('smart-troskovnik')?.data.description || ''} href="/projekti/smart-troskovnik/" image={projectById.get('smart-troskovnik')?.data.cover} imageAlt={projectById.get('smart-troskovnik')?.data.coverAlt}/>
    <ProjectCard type={projectById.get('gloss-glow')?.data.type || 'Web stranica'} title="Gloss & Glow" description={projectById.get('gloss-glow')?.data.description || ''} href="/projekti/gloss-glow/" image={projectById.get('gloss-glow')?.data.cover} imageAlt={projectById.get('gloss-glow')?.data.coverAlt}/>
    <ProjectCard type={projectById.get('driveq')?.data.type || 'Digitalno rješenje'} title="DriveQ" description={projectById.get('driveq')?.data.description || ''} href="/projekti/driveq/" image={projectById.get('driveq')?.data.cover} imageAlt={projectById.get('driveq')?.data.coverAlt}/>
    <ProjectCard type={projectById.get('proinmont-jedan')?.data.type || 'Web stranica'} title="Pro in mont jedan j.d.o.o." description={projectById.get('proinmont-jedan')?.data.description || ''} href="/projekti/proinmont-jedan/" image={projectById.get('proinmont-jedan')?.data.cover} imageAlt={projectById.get('proinmont-jedan')?.data.coverAlt}/>
  </div><div class="section-link"><a class="text-link" href="/projekti/">Svi projekti <span>→</span></a></div></div></section>

  <section class="section insight-section"><div class="container insight"><div><div class="eyebrow">Digitalni vodič</div><h2>Odgovori na pitanja koja poduzetnici stvarno postavljaju.</h2></div><div><p>Praktični vodiči o SEO-u, web stranicama, AI rješenjima i web aplikacijama — bez nepotrebnog tehničkog žargona.</p><a class="button secondary" href="/vodic/">Otvori vodič <span>↗</span></a></div></div></section>
  <div class="container"><CTA /></div>
</BaseLayout>
