---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Stranica nije pronađena | BrandistiQ" description="Tražena stranica nije pronađena. Vratite se na početnu stranicu BrandistiQ-a.">
  <section class="error-page">
    <div class="container">
      <div class="eyebrow">404 · Nije pronađeno</div>
      <h1>Ova stranica ne postoji.</h1>
      <p>Izgleda da je poveznica zastarjela ili je adresa pogrešno unesena. Možete nastaviti s početne stranice.</p>
      <div class="actions"><a class="button" href="/">Na početnu <span>↗</span></a><a class="text-link" href="/kontakt/">Kontakt <span>→</span></a></div>
    </div>
  </section>
</BaseLayout>
