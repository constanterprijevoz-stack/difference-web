---
import { getEntry, render } from 'astro:content';
import ServicePage from '../../components/ServicePage.astro';
const entry = await getEntry('usluge', 'lokalni-seo');
if (!entry) throw new Error('Missing content: lokalni-seo');
const { Content } = await render(entry);
---
<ServicePage entry={entry} section="SEO" label="BrandistiQ · SEO"><Content /></ServicePage>
