---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from './CTA.astro';
const { entry, section, label } = Astro.props;
const sectionUrl = section === 'SEO' ? 'seo' : section === 'Web' ? 'web-stranice' : 'ai-rjesenja';
const breadcrumbs = [
  { name: 'Početna', url: '/' },
  { name: section, url: `/${sectionUrl}/` },
  { name: entry.data.title, url: Astro.url.pathname },
];
const serviceSchema = {
  '@context':'https://schema.org',
  '@type':'Service',
  name:entry.data.title,
  description:entry.data.description,
  url:new URL(Astro.url.pathname, 'https://difference-usluge.com.hr').toString(),
  provider:{ '@type':'Organization', name:'BrandistiQ', url:'https://difference-usluge.com.hr/' }
};
const serviceLabel = label ?? `BrandistiQ · ${section}`;
---
<BaseLayout title={`${entry.data.title} | BrandistiQ`} description={entry.data.description} breadcrumbs={breadcrumbs} structuredData={[serviceSchema]}>
  <article class="article-page">
    <div class="container article-wrap">
      <div class="eyebrow">{serviceLabel}</div>
      <h1>{entry.data.title}</h1>
      <p class="article-lead">{entry.data.description}</p>
      <div class="article-body"><slot /></div>
      <CTA title="Želite razgovarati o projektu?" text="Pošaljite nam osnovne informacije. Zajedno možemo definirati prvi konkretan korak." />
    </div>
  </article>
</BaseLayout>
