---
const { number, title, description, href, variant = 'blue' } = Astro.props;
---
<a class={`service-card service-card-${variant}`} href={href}>
  <div class="service-card-visual" aria-hidden="true">
    {variant === 'teal' && (
      <svg class="service-visual-svg" viewBox="0 0 320 220">
        <defs>
          <linearGradient id="seoGlow" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#77f2d0" stop-opacity=".9"/>
            <stop offset="1" stop-color="#3ab6a2" stop-opacity=".08"/>
          </linearGradient>
        </defs>
        <rect x="26" y="28" width="268" height="164" rx="18" class="visual-window"/>
        <circle cx="50" cy="50" r="4" class="visual-dot"/>
        <circle cx="64" cy="50" r="4" class="visual-dot"/>
        <circle cx="78" cy="50" r="4" class="visual-dot"/>
        <path d="M48 158 C88 142 100 145 132 119 S176 105 201 76 S244 65 272 42" class="visual-line"/>
        <path d="M48 158 C88 142 100 145 132 119 S176 105 201 76 S244 65 272 42 L272 174 L48 174Z" fill="url(#seoGlow)" class="visual-area"/>
        <path d="M48 174H272M48 174V64" class="visual-axis"/>
        <circle cx="201" cy="76" r="7" class="visual-point"/>
        <path d="M246 42h26v26" class="visual-arrow"/>
      </svg>
    )}

    {variant === 'blue' && (
      <svg class="service-visual-svg" viewBox="0 0 320 220">
        <rect x="25" y="27" width="270" height="166" rx="18" class="visual-window"/>
        <rect x="25" y="27" width="270" height="35" rx="18" class="visual-window-top"/>
        <circle cx="49" cy="45" r="4" class="visual-dot"/>
        <circle cx="63" cy="45" r="4" class="visual-dot"/>
        <circle cx="77" cy="45" r="4" class="visual-dot"/>
        <rect x="48" y="82" width="92" height="11" rx="5" class="visual-block"/>
        <rect x="48" y="104" width="166" height="7" rx="3" class="visual-soft"/>
        <rect x="48" y="119" width="140" height="7" rx="3" class="visual-soft"/>
        <rect x="48" y="148" width="70" height="27" rx="8" class="visual-card"/>
        <rect x="128" y="148" width="70" height="27" rx="8" class="visual-card"/>
        <rect x="208" y="82" width="61" height="93" rx="10" class="visual-panel"/>
      </svg>
    )}

    {variant === 'purple' && (
      <svg class="service-visual-svg" viewBox="0 0 320 220">
        <circle cx="160" cy="110" r="54" class="ai-core"/>
        <circle cx="160" cy="110" r="25" class="ai-core-inner"/>
        <circle cx="70" cy="56" r="10" class="ai-node"/>
        <circle cx="255" cy="63" r="10" class="ai-node"/>
        <circle cx="66" cy="164" r="10" class="ai-node"/>
        <circle cx="257" cy="158" r="10" class="ai-node"/>
        <path d="M79 61 119 83M241 68l-39 18M76 159l40-27M247 153l-43-25" class="ai-link"/>
        <rect x="110" y="94" width="100" height="32" rx="16" class="ai-message"/>
        <rect x="124" y="103" width="48" height="7" rx="3" class="ai-message-line"/>
        <rect x="145" y="132" width="62" height="23" rx="12" class="ai-message ai-message-alt"/>
        <circle cx="159" cy="143" r="3" class="ai-message-dot"/>
        <circle cx="169" cy="143" r="3" class="ai-message-dot"/>
        <circle cx="179" cy="143" r="3" class="ai-message-dot"/>
      </svg>
    )}

    {variant === 'orange' && (
      <svg class="service-visual-svg" viewBox="0 0 320 220">
        <rect x="32" y="34" width="256" height="154" rx="18" class="app-window"/>
        <rect x="32" y="34" width="256" height="34" rx="18" class="app-top"/>
        <circle cx="55" cy="51" r="4" class="visual-dot"/>
        <circle cx="69" cy="51" r="4" class="visual-dot"/>
        <circle cx="83" cy="51" r="4" class="visual-dot"/>
        <rect x="52" y="83" width="62" height="82" rx="10" class="app-side"/>
        <rect x="128" y="84" width="66" height="33" rx="9" class="app-card"/>
        <rect x="204" y="84" width="64" height="33" rx="9" class="app-card"/>
        <rect x="128" y="129" width="140" height="36" rx="9" class="app-chart"/>
        <path d="M140 154 157 143l18 8 19-16 17 7 20-12" class="app-line"/>
      </svg>
    )}
  </div>

  <div class="card-number">{number}</div>
  <div class="service-card-copy">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <span class="card-arrow">↗</span>
</a>
