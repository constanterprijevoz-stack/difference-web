---
const { number, title, description, href, variant = 'blue' } = Astro.props;
---

<a class={`service-card service-card-${variant}`} href={href}>
  <div class="service-visual" aria-hidden="true">

    {variant === 'teal' && (
      <svg viewBox="0 0 520 270" role="presentation">
        <defs>
          <linearGradient id="seoFill" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#16c7a1" stop-opacity=".08"/>
            <stop offset=".65" stop-color="#25e0bd" stop-opacity=".34"/>
            <stop offset="1" stop-color="#8affdf" stop-opacity=".62"/>
          </linearGradient>
        </defs>
        <rect x="24" y="24" width="472" height="222" rx="24" fill="#0d151f" stroke="#385066" stroke-width="2"/>
        <rect x="24" y="24" width="472" height="42" rx="24" fill="#182737"/>
        <circle cx="51" cy="45" r="5" fill="#71839a"/>
        <circle cx="68" cy="45" r="5" fill="#71839a"/>
        <circle cx="85" cy="45" r="5" fill="#71839a"/>
        <rect x="112" y="37" width="170" height="16" rx="8" fill="#0a121b" stroke="#3b566f"/>
        <text x="128" y="49" font-family="Arial,sans-serif" font-size="8" font-weight="600" letter-spacing="1" fill="#93a8bc">google / search</text>
        <path d="M60 205 C112 185 126 191 164 163 S225 151 264 124 S327 112 363 80 S426 68 462 48 L462 222 L60 222Z" fill="url(#seoFill)"/>
        <path d="M60 205 C112 185 126 191 164 163 S225 151 264 124 S327 112 363 80 S426 68 462 48" fill="none" stroke="#59e3c4" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="363" cy="80" r="9" fill="#9affdf" stroke="#17483f" stroke-width="6"/>
        <path d="M432 48h30v30" fill="none" stroke="#73efd1" stroke-width="4" stroke-linecap="round"/>
        <text x="60" y="96" font-family="Arial,sans-serif" font-size="9" font-weight="600" letter-spacing="1.4" fill="#8fa4b8">ORGANIC VISIBILITY</text>
        <text x="60" y="119" font-family="Arial,sans-serif" font-size="15" font-weight="700" fill="#d9fff5">+ visibility</text>
      </svg>
    )}

    {variant === 'blue' && (
      <svg viewBox="0 0 520 270" role="presentation">
        <defs>
          <linearGradient id="webScreen" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#17375d"/>
            <stop offset="1" stop-color="#0c1725"/>
          </linearGradient>
        </defs>
        <rect x="24" y="24" width="472" height="222" rx="24" fill="#0d151f" stroke="#385066" stroke-width="2"/>
        <rect x="24" y="24" width="472" height="42" rx="24" fill="#182737"/>
        <circle cx="51" cy="45" r="5" fill="#71839a"/>
        <circle cx="68" cy="45" r="5" fill="#71839a"/>
        <circle cx="85" cy="45" r="5" fill="#71839a"/>
        <rect x="112" y="37" width="250" height="16" rx="8" fill="#0a121b" stroke="#3b566f"/>
        <rect x="50" y="86" width="270" height="135" rx="15" fill="url(#webScreen)" stroke="#4b7bad" stroke-width="1.5"/>
        <rect x="344" y="86" width="116" height="62" rx="13" fill="#172b42" stroke="#47709a" stroke-width="1.5"/>
        <rect x="344" y="159" width="116" height="62" rx="13" fill="#172b42" stroke="#47709a" stroke-width="1.5"/>
        <rect x="68" y="106" width="108" height="10" rx="5" fill="#c3dcff"/>
        <rect x="68" y="128" width="175" height="7" rx="3" fill="#66809e"/>
        <rect x="68" y="143" width="140" height="7" rx="3" fill="#66809e"/>
        <rect x="68" y="174" width="70" height="27" rx="8" fill="#6da7ff"/>
        <rect x="158" y="174" width="70" height="27" rx="8" fill="#1b314b" stroke="#6b95c5"/>
        <rect x="363" y="104" width="55" height="8" rx="4" fill="#c3dcff"/>
        <rect x="363" y="119" width="70" height="6" rx="3" fill="#66809e"/>
        <circle cx="402" cy="188" r="17" fill="#1b3857" stroke="#74b0ff" stroke-width="2"/>
        <path d="M394 188l6 6 11-13" fill="none" stroke="#b8d9ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    )}

    {variant === 'purple' && (
      <svg viewBox="0 0 520 270" role="presentation">
        <defs>
          <radialGradient id="aiGlow">
            <stop offset="0" stop-color="#c09aff" stop-opacity=".62"/>
            <stop offset=".55" stop-color="#8655e8" stop-opacity=".20"/>
            <stop offset="1" stop-color="#8655e8" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <circle cx="260" cy="135" r="128" fill="url(#aiGlow)"/>
        <path d="M90 68L198 112M430 68L322 112M91 207L198 158M429 207L322 158" fill="none" stroke="#8059aa" stroke-width="2"/>
        <circle cx="90" cy="68" r="13" fill="#251839" stroke="#b58cff" stroke-width="2"/>
        <circle cx="430" cy="68" r="13" fill="#251839" stroke="#b58cff" stroke-width="2"/>
        <circle cx="91" cy="207" r="13" fill="#251839" stroke="#b58cff" stroke-width="2"/>
        <circle cx="429" cy="207" r="13" fill="#251839" stroke="#b58cff" stroke-width="2"/>
        <circle cx="260" cy="135" r="66" fill="#27173e" stroke="#ae7cff" stroke-width="2"/>
        <circle cx="260" cy="135" r="36" fill="#9b67f2"/>
        <path d="M248 124h24M248 135h24M248 146h15" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
        <rect x="167" y="48" width="92" height="32" rx="16" fill="#251a38" stroke="#8c63bb"/>
        <rect x="261" y="190" width="104" height="32" rx="16" fill="#33204a" stroke="#a174d8"/>
        <rect x="185" y="60" width="48" height="6" rx="3" fill="#d8c3ff"/>
        <rect x="279" y="202" width="62" height="6" rx="3" fill="#d8c3ff"/>
        <text x="38" y="252" font-family="Arial,sans-serif" font-size="9" font-weight="600" letter-spacing="1.2" fill="#bba7d5">AI · AUTOMATION · ASSISTANTS</text>
      </svg>
    )}

    {variant === 'orange' && (
      <svg viewBox="0 0 520 270" role="presentation">
        <defs>
          <linearGradient id="dash" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#3d2817"/>
            <stop offset="1" stop-color="#17100a"/>
          </linearGradient>
        </defs>
        <rect x="24" y="24" width="472" height="222" rx="24" fill="#0f151d" stroke="#4e5a68" stroke-width="2"/>
        <rect x="24" y="24" width="472" height="42" rx="24" fill="#1d2834"/>
        <circle cx="51" cy="45" r="5" fill="#71839a"/>
        <circle cx="68" cy="45" r="5" fill="#71839a"/>
        <circle cx="85" cy="45" r="5" fill="#71839a"/>
        <rect x="50" y="86" width="92" height="135" rx="14" fill="#24180f" stroke="#765131"/>
        <rect x="162" y="86" width="100" height="58" rx="13" fill="url(#dash)" stroke="#805735"/>
        <rect x="278" y="86" width="100" height="58" rx="13" fill="url(#dash)" stroke="#805735"/>
        <rect x="394" y="86" width="66" height="58" rx="13" fill="url(#dash)" stroke="#805735"/>
        <rect x="162" y="158" width="298" height="63" rx="14" fill="#1f1710" stroke="#765031"/>
        <path d="M181 201l30-19 28 10 34-28 35 18 39-22 46 13" fill="none" stroke="#ffad62" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="70" y="108" width="50" height="7" rx="3" fill="#ffb36b"/>
        <rect x="70" y="129" width="37" height="6" rx="3" fill="#8a6040"/>
        <rect x="70" y="149" width="45" height="6" rx="3" fill="#8a6040"/>
        <rect x="70" y="169" width="31" height="6" rx="3" fill="#8a6040"/>
        <text x="181" y="105" font-family="Arial,sans-serif" font-size="8" font-weight="700" letter-spacing="1.2" fill="#d29b68">DATA</text>
        <text x="297" y="105" font-family="Arial,sans-serif" font-size="8" font-weight="700" letter-spacing="1.2" fill="#d29b68">PROCESS</text>
        <text x="412" y="105" font-family="Arial,sans-serif" font-size="8" font-weight="700" letter-spacing="1.2" fill="#d29b68">LIVE</text>
      </svg>
    )}
  </div>

  <div class="service-top">
    <span class="card-number">{number}</span>
    <span class="card-arrow">↗</span>
  </div>

  <div class="service-card-copy">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>

<style>
  .service-card{
    min-height:480px;
    padding:0;
    position:relative;
    overflow:hidden;
    isolation:isolate;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    border:0;
    transition:transform .25s ease,background .25s ease;
  }
  .service-card:hover{transform:translateY(-2px)}

  /* The artwork must sit above the card background and below the text. */
  .service-visual{
    position:absolute;
    inset:0;
    display:grid;
    place-items:center;
    padding:34px 28px 118px;
    z-index:2;
    pointer-events:none;
    opacity:1;
    visibility:visible;
  }
  .service-visual svg{
    display:block;
    width:100%;
    height:auto;
    max-width:620px;
    max-height:none;
    min-height:220px;
    overflow:visible;
    opacity:1;
    visibility:visible;
    filter:drop-shadow(0 18px 38px rgba(0,0,0,.34));
  }

  /* A restrained fade keeps the copy readable without hiding the artwork. */
  .service-card::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(180deg,rgba(7,9,13,0) 38%,rgba(7,9,13,.10) 54%,rgba(7,9,13,.94) 86%);
    pointer-events:none;
    z-index:3;
  }

  .service-card-teal{background:radial-gradient(circle at 70% 24%,rgba(25,224,187,.18),transparent 48%),#0a1215}
  .service-card-blue{background:radial-gradient(circle at 70% 24%,rgba(85,151,255,.19),transparent 48%),#0a111b}
  .service-card-purple{background:radial-gradient(circle at 70% 24%,rgba(151,93,255,.21),transparent 48%),#100b17}
  .service-card-orange{background:radial-gradient(circle at 70% 24%,rgba(255,157,76,.20),transparent 48%),#15100b}

  .service-top{
    position:absolute;
    top:26px;
    left:30px;
    right:30px;
    display:flex;
    justify-content:space-between;
    z-index:5;
  }
  .card-number{color:#9aa8bb;font-size:.72rem;letter-spacing:.12em}
  .card-arrow{color:#c5d5eb;font-size:1.15rem}
  .service-card-copy{
    position:relative;
    z-index:5;
    padding:0 30px 30px;
    max-width:680px;
  }
  .service-card h3{
    font-family:'Space Grotesk',sans-serif;
    font-size:clamp(1.55rem,2.5vw,2rem);
    letter-spacing:-.045em;
    margin:0 0 8px;
  }
  .service-card p{
    color:#aeb8c8;
    margin:0;
    max-width:590px;
    font-size:.92rem;
    line-height:1.55;
  }
  @media(max-width:650px){
    .service-card{min-height:430px}
    .service-visual{padding:30px 14px 108px}
    .service-visual svg{min-height:190px}
    .service-card-copy{padding:0 22px 24px}
    .service-top{left:22px;right:22px;top:22px}
  }
</style>
